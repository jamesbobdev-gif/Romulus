{
  "name": "romulus",
  "productName": "Romulus",
  "version": "1.2.0",
  "description": "Romulus",
  "main": "main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "test": "node --test \"test/*.test.js\"",
    "lint": "eslint .",
    "release": "node scripts/release.js",
    "demo": "node scripts/demo/build.js && electron scripts/demo/record.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "electron": "33.4.11",
    "electron-builder": "^25.1.8",
    "eslint": "^9.39.5",
    "globals": "^17.14.0"
  },
  "build": {
    "appId": "com.jartro.tasks",
    "productName": "Romulus",
    "files": [
      "main.js",
      "main/**",
      "preload.js",
      "renderer/**",
      "assets/**",
      "agent/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true
    },
    "appx": {
      "displayName": "Romulus",
      "applicationId": "Romulus",
      "backgroundColor": "transparent",
      "languages": [
        "en-US"
      ]
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": "AppImage"
    },
    "publish": {
      "provider": "github",
      "owner": "jamesbobdev-gif",
      "repo": "romulus-releases",
      "releaseType": "release"
    },
    "nsis": {
      "artifactName": "Romulus-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "qrcode": "^1.5.4"
  }
}
