{
  "name": "tasks",
  "productName": "Tasks",
  "version": "1.0.0",
  "description": "A clean, minimal to-do app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.jartro.tasks",
    "productName": "Tasks",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "assets/**",
      "agent/**"
    ],
    "mac": {
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
