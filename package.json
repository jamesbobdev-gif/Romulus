{
  "name": "romulus",
  "productName": "Romulus",
  "version": "1.0.27",
  "description": "Romulus",
  "main": "main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "test": "node --test \"test/*.test.js\"",
    "release": "node scripts/release.js"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.jartro.tasks",
    "productName": "Romulus",
    "files": [
      "main.js",
      "main/**",
      "preload.js",
      "renderer/**",
      "assets/**",
      "agent/**"
    ],
    "asarUnpack": [
      "node_modules/@playwright/mcp/**",
      "node_modules/playwright/**",
      "node_modules/playwright-core/**",
      "node_modules/npm/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] },
        { "target": "zip", "arch": ["arm64", "x64"] }
      ],
      "hardenedRuntime": true
    },
    "appx": {
      "displayName": "Romulus",
      "applicationId": "Romulus",
      "backgroundColor": "transparent",
      "languages": ["en-US"]
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": "AppImage"
    },
    "publish": {
      "provider": "github",
      "owner": "jamesbobdev-gif",
      "repo": "romulus-releases",
      "releaseType": "release"
    },
    "nsis": {
      "artifactName": "Romulus-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "@playwright/mcp": "0.0.83",
    "electron-updater": "^6.8.9",
    "npm": "10.9.10",
    "qrcode": "^1.5.4"
  }
}
