{
  "name": "tasks",
  "productName": "Tasks",
  "version": "1.0.0",
  "description": "A clean, minimal to-do app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "test": "node --test \"test/*.test.js\""
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.jartro.tasks",
    "productName": "Tasks",
    "files": [
      "main.js",
      "main/**",
      "preload.js",
      "renderer/**",
      "assets/**",
      "agent/**",
      "oauth-clients.json"
    ],
    "mac": {
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
