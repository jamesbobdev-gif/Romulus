{
  "name": "romulus",
  "productName": "Romulus",
  "version": "1.3.1",
  "description": "Romulus",
  "main": "main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "test": "node --test \"test/*.test.js\"",
    "release": "node scripts/release.js"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.jartro.tasks",
    "productName": "Romulus",
    "files": [
      "main.js",
      "main/**",
      "preload.js",
      "renderer/**",
      "assets/**",
      "agent/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true
    },
    "appx": {
      "displayName": "Romulus",
      "applicationId": "Romulus",
      "backgroundColor": "transparent",
      "languages": [
        "en-US"
      ]
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "synopsis": "Tasks, calendar and an AI agent that does the errands, with your yes",
      "description": "A task list with an AI agent built in: it plans your day, reminds you on time, and takes errands off your hands, asking before anything that can't be undone.",
      "maintainer": "Romulus <jamesbobdev-gif@users.noreply.github.com>",
      "vendor": "Romulus"
    },
    "deb": {
      "artifactName": "Romulus-${version}-${arch}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "jamesbobdev-gif",
      "repo": "romulus-releases",
      "releaseType": "release"
    },
    "nsis": {
      "artifactName": "Romulus-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "qrcode": "^1.5.4"
  }
}
