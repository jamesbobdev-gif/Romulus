<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Apple Health, read-only (HealthDataPlugin.swift); the App ID needs HealthKit on, which automatic signing adds -->
	<!-- the home-screen widgets read the app's rows through this group (WidgetShared.swift) -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.jartro.tasks</string>
	</array>
	<key>com.apple.developer.healthkit</key>
	<true/>
	<key>com.apple.developer.healthkit.access</key>
	<array/>
</dict>
</plist>
